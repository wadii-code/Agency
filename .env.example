# Copy to .env.local and fill in.

# Public origin of the site (custom domain), used for canonical URLs, the
# sitemap, robots.txt, Open Graph and structured data. On Vercel it defaults
# to the project's production domain.
NEXT_PUBLIC_SITE_URL=https://example.com

# Google Search Console: the content of the HTML-tag verification token
# (or verify the domain through DNS instead and leave this empty).
GOOGLE_SITE_VERIFICATION=

# Web3Forms access key for the contact popup (https://web3forms.com).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
